# Copy this file to .env and fill in your own values.

# ---- MySQL ----------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=data_scientist_agent

# ---- Gemini ---------------------------------------------------------------
# Optional. Get a free key at https://aistudio.google.com/apikey
# If this is left blank the app falls back to its built-in rule-based analyst
# and every feature still works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Limits ---------------------------------------------------------------
MAX_UPLOAD_MB=50
MAX_TRAINING_ROWS=50000
